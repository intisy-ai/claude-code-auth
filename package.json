{
  "name": "claude-code-auth",
  "version": "2.12.5",
  "description": "Claude Code subscription auth provider for OpenCode and Claude Code, multiple Claude accounts via OAuth, with subscription rate limits exposed to OpenCode.",
  "main": "dist/index.js",
  "type": "module",
  "license": "MIT",
  "author": "intisy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intisy-ai/claude-code-auth.git"
  },
  "keywords": [
    "opencode",
    "claude",
    "claude-code",
    "anthropic",
    "oauth",
    "subscription",
    "provider",
    "auth"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/",
    "plugin.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "claude-code-auth": "dist/cli.js"
  },
  "claudeHub": {
    "authProviders": [
      {
        "name": "claude-code",
        "handler": "dist/handler.js",
        "models": []
      }
    ]
  },
  "scripts": {
    "emit:teavm": "node node_modules/@intisy/bayonet/scripts/emit-dts.mjs --java-dir . --module :claude-teavm --out src/generated",
    "build": "npm run emit:teavm && node node_modules/@intisy/bayonet/scripts/teavm-build.mjs --java-dir . --module :claude-teavm --out src/generated/claude-orchestrator.teavm.js && node build.mjs",
    "test": "npm run build && npm run typecheck && vitest run",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "postbuild": "node dist/index.js readme"
  },
  "dependencies": {
    "@intisy-ai/anthropic-translator": "^1.0.2",
    "@intisy-ai/basekit": "^5.0.0",
    "@openauthjs/openauth": "^0.4.3"
  },
  "devDependencies": {
    "@intisy/bayonet": "^1.8.0",
    "@types/node": "^22.19.19",
    "esbuild": "^0.25.12",
    "typescript": "^5.0.0",
    "vitest": "^4.1.7"
  }
}
